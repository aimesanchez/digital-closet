{
  "expo": {
    "name": "Wearly",
    "slug": "digital-closet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Wearly-logo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3ED",
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aimsan33.digitalcloset",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3ED",
        "foregroundImage": "./assets/Wearly-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "94697964-a238-4feb-aae9-4f80d4219586"
      }
    }
  }
}
